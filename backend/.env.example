# Environment
ENVIRONMENT=development

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://care_user:care_secure_password@localhost:5432/care_db
# For tests without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./care_app_test.db
DATABASE_ECHO=false

# LLM provider: gemini (default) or groq
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq Cloud (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude (disabled — uncomment in config.py + claude_service.py to revert)
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (JSON array string)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_SECONDS=60
